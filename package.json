{
  "name": "country-search",
  "version": "1.0.0",
  "description": "A live country search app that queries the public countries.dev API by name as the user types, showing matching countries in real time.",
  "keywords": [
    "javascript",
    "typescript",
    "fetch",
    "promise",
    "async/await",
    "abortcontroller",
    "debounce",
    "error handling",
    "tdd",
    "first",
    "jest",
    "eslint",
    "prettier",
    "husky"
  ],
  "homepage": "https://github.com/sofiiadorosh/country-search#readme",
  "bugs": {
    "url": "https://github.com/sofiiadorosh/country-search/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sofiiadorosh/country-search.git"
  },
  "author": "Sofiia Dorosh",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --passWithNoTests",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --check"
    ],
    "*.{js,json,html,css,md}": "prettier --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
